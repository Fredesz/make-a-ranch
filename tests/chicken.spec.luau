
local keeper = join(30)
advance(0)
assert(BuildService.Place(keeper, "ChickenCoop", -2, -2, 0))
local coop = ChickenService.GetCoop(keeper)
assert(coop and coop:FindFirstChild("Chicken"))
assert(PlayerDataService.GetCoins(keeper) == 30)
assert(not BuildService.Place(keeper, "ChickenCoop", 2, 2, 0))
standAt(keeper, coop.Position)
assert(not ChickenService.Collect(keeper, coop))
advance(AnimalConfig.Chicken.ProductionTime)
assert(coop:FindFirstChild("Egg"))
assert(not ChickenService.Collect(builder, coop))
assert(ChickenService.Collect(keeper, coop))
assert(not ChickenService.Collect(keeper, coop))
local eggs = InventoryService.GetInventory(keeper)
assert(#eggs == 1 and eggs[1].ItemId == "Egg"
    and eggs[1].Variant == "Normal" and eggs[1].Quantity == 1)
assert(PlayerDataService.GetCoins(keeper) == 30)
advance(AnimalConfig.Chicken.ProductionTime)
assert(ChickenService.Collect(keeper, coop))
assert(InventoryService.GetInventory(keeper)[1].Quantity == 2)
local sellPad = SellService.GetPad(keeper)
assert(sellPad)
standAt(keeper, sellPad.Position)
assert(not SellService.Sell(builder, "Egg", "Normal", 1))
assert(not SellService.Sell(keeper, "Egg", "Normal", 0))
assert(not SellService.Sell(keeper, "Egg", "Normal", -1))
assert(not SellService.Sell(keeper, "Egg", "Normal", 3))
assert(not SellService.Sell(keeper, "Egg", "Golden", 1))
assert(PlayerDataService.GetCoins(keeper) == 30)
assert(InventoryService.GetInventory(keeper)[1].Quantity == 2)
standAt(keeper, sellPad.Position + Vector3.new(100, 0, 0))
assert(not SellService.Sell(keeper, "Egg", "Normal", 1))
standAt(keeper, sellPad.Position)
assert(SellService.Sell(keeper, "Egg", "Normal", 1, 999999))
assert(PlayerDataService.GetCoins(keeper) == 30 + ProductConfig.Egg.SellPrice)
assert(InventoryService.GetInventory(keeper)[1].Quantity == 1)
local sellPrompt = sellPad:FindFirstChildOfClass("ProximityPrompt")
assert(sellPrompt)
sellPrompt.Triggered:Fire(keeper)
assert(#InventoryService.GetInventory(keeper) == 0)
assert(PlayerDataService.GetCoins(keeper) == 30 + 2 * ProductConfig.Egg.SellPrice)
assert(not SellService.Sell(keeper, "Egg", "Normal", 1))
assert(PlayerDataService.GetCoins(keeper) == 30 + 2 * ProductConfig.Egg.SellPrice)
leave(keeper)
advance(AnimalConfig.Chicken.ProductionTime)
assert(ChickenService.GetCoop(keeper) == nil)
assert(InventoryService.GetInventory(keeper) == nil)
print("PASS: coop, eggs, configured sale price, prompt, invalid sales and cleanup")
